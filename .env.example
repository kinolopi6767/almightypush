# ---- PushPanel environment ----
# Copy to .env and adjust. Never commit real keys.

# SQLite database file. Relative paths resolve against the repo root
# (dev) or /app (Docker). Absolute paths used as-is.
DATABASE_PATH=./data/pushpanel.db

# Panel base URL, no trailing slash.
APP_URL=http://localhost:3000

# 32 bytes as 64 hex chars — encrypts push tokens, provider configs, API keys.
# Generate with: openssl rand -hex 32
APP_ENC_KEY=

# Auth.js secret (use: openssl rand -hex 32)
AUTH_SECRET=

# Owner account bootstrap email (password is set once via /setup).
OWNER_EMAIL=
OWNER_NAME=

# Panel timezone for schedules (IANA tz) — your local for schedule picker.
# Use Asia/Karachi for Pakistan (was Asia/Kolkata for India).
DEFAULT_TIMEZONE=Asia/Karachi

# Reverse proxy trust: set to 1 when behind Coolify/Nginx/Caddy so X-Forwarded-For is honored.
# Without this, rate limits collapse to a global "unknown" bucket and IP attribution is lost.
TRUST_PROXY=1

# Personal single-tenant: unlimited by default. Set only if you want a hard cap.
# Leave empty for unlimited (recommended for private use).
MAX_SUBSCRIBERS_PER_DOMAIN=

# --- Worker knobs — tuned for 1M on single VPS (Coolify/AWS free) ---
# 1M scale: 500/batch → 1M queued in 200 tx. AWS t2.micro 1GB → 100, 2GB+ VPS → 1000
WORKER_BATCH_SIZE=500
SCHEDULER_CHUNK=500
SQLITE_CACHE_MB=64            # 64 for 1GB free tier, 256 for 2GB+ VPS
WORKER_TICK_MS=5000
WORKER_IDLE_TICK_MS=60000
# Retention for 1M: keep DB <10GB — deliveries 7d, events 30d (tune via settings or env)
# RETENTION_DELIVERIES_DAYS=7
# RETENTION_EVENTS_DAYS=30

# Optional: Litestream R2 for ephemeral free tiers (Render/Koyeb) or 1M extra safety
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pushpanel-litestream

# Allow private upstream hosts (dev/test only) — enables SSRF guard bypass for localhost mocks.
# ALLOW_PRIVATE_UPSTREAM=1

# --- Docker only ---
# Web port (default 3000)
# PORT=3000