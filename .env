# ---- PushPanel — generated for larapush.instantnotes.online (2026-08-21) ----
# Paste these into Coolify → Docker Compose → Environment Variables
# Or keep as .env for `docker compose up` on VPS. Never commit this file.

DATABASE_PATH=/app/data/pushpanel.db
APP_URL=https://larapush.instantnotes.online

# APP_ENC_KEY: AES-256-GCM at-rest encryption for push tokens / VAPID private keys / API keys / Drive JSON
# Generated: openssl rand -hex 32 (64 hex = 32 bytes)
APP_ENC_KEY=018546be5f1425208ea36abfa447de538f6f39e55c77e4b85959a3b56ab618e8

# AUTH_SECRET: NextAuth JWT signing secret — any random 32+ bytes
# Generated: openssl rand -hex 32
AUTH_SECRET=401acac053ed3639e3212eb002494e91c5d3e7f33857d1d62a98780eb9c078ec

OWNER_EMAIL=admin@instantnotes.online
OWNER_NAME=Admin
DEFAULT_TIMEZONE=Asia/Karachi

# Reverse proxy (Coolify/Nginx) — must be 1 so X-Forwarded-For is trusted for rate-limit
TRUST_PROXY=1

# Personal single-tenant: unlimited (leave empty)
MAX_SUBSCRIBERS_PER_DOMAIN=

# Worker — tuned for 1GB free (64MB) / 2GB+ VPS use 256
SQLITE_CACHE_MB=64
WORKER_BATCH_SIZE=500
SCHEDULER_CHUNK=500
SEND_TIMEOUT_MS=15000
SENDING_SPEED_PER_SEC=0
WORKER_TICK_MS=5000
WORKER_IDLE_TICK_MS=60000

# Backups — local VACUUM INTO + optional Drive (disabled by default, enable in Dashboard → Settings)
# To enable Drive: Dashboard → Settings → Google Drive → paste Service Account JSON + enable
# Litestream R2 (optional, for ephemeral free tiers) — leave empty for persistent volume VPS
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pushpanel-litestream

# Dev only — allow localhost feeds in automations (keep commented in prod)
# ALLOW_PRIVATE_UPSTREAM=1

PORT=3000
NODE_ENV=production
